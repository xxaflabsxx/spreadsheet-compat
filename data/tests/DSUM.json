{
  "function": "DSUM",
  "cases": [
    {
      "id": "DSUM_matching_criteria",
      "formula": "=DSUM(A1:B4,\"Sales\",D1:D2)",
      "description": "Sums the Sales column only for rows matching the criteria range (Region = East)",
      "setup_cells": {
        "A1": "Region", "B1": "Sales",
        "A2": "East", "B2": 100,
        "A3": "West", "B3": 200,
        "A4": "East", "B4": 50,
        "D1": "Region", "D2": "East"
      },
      "expected": 150
    },
    {
      "id": "DSUM_field_by_number",
      "formula": "=DSUM(A1:B4,2,D1:D2)",
      "description": "The field can be given as a column number (2) instead of its header name",
      "setup_cells": {
        "A1": "Region", "B1": "Sales",
        "A2": "East", "B2": 100,
        "A3": "West", "B3": 200,
        "A4": "East", "B4": 50,
        "D1": "Region", "D2": "East"
      },
      "expected": 150
    },
    {
      "id": "DSUM_numeric_condition",
      "formula": "=DSUM(A1:B4,\"Sales\",D1:D2)",
      "description": "Criteria can be a comparison expression, e.g. Sales greater than 75",
      "setup_cells": {
        "A1": "Region", "B1": "Sales",
        "A2": "East", "B2": 100,
        "A3": "West", "B3": 200,
        "A4": "East", "B4": 50,
        "D1": "Sales", "D2": ">75"
      },
      "expected": 300
    }
  ]
}
