{
  "function": "VARA",
  "cases": [
    {
      "id": "VARA_numbers_only",
      "formula": "=VARA(2,4,6)",
      "description": "For pure numbers VARA equals VAR (sample variance dividing by n-1)",
      "expected": 4
    },
    {
      "id": "VARA_counts_text_as_zero",
      "formula": "=VARA(A1:A3)",
      "description": "Unlike VAR, VARA counts text as 0, so {2,4,\"x\"} is treated as {2,4,0}: sample variance 4",
      "setup_cells": {"A1": 2, "A2": 4, "A3": "x"},
      "expected": 4
    },
    {
      "id": "VARA_identical_values",
      "formula": "=VARA(9,9,9)",
      "description": "Identical values have zero variance",
      "expected": 0
    }
  ]
}
