{
  "function": "EXPAND",
  "cases": [
    {
      "id": "EXPAND_pad_rows",
      "formula": "=EXPAND(A1:A2,3,1,0)",
      "description": "Grows a 2-row array to 3 rows, padding the new cell with 0",
      "setup_cells": {"A1": 5, "A2": 7},
      "check_range": "H1:H3",
      "expected": [5, 7, 0]
    },
    {
      "id": "EXPAND_pad_cols",
      "formula": "=EXPAND(A1:A1,1,3,0)",
      "description": "Grows a single cell to 3 columns wide, padding with 0",
      "setup_cells": {"A1": 5},
      "check_range": "H1:J1",
      "expected": [5, 0, 0]
    }
  ]
}
