      "formula": "=DCOUNT(A1:B4,\"Sales\",D1:D2)",
      "description": "Counts the numeric Sales entries for rows matching the criteria (Region = East)",
      "setup_cells": {
        "A1": "Region", "B1": "Sales",
        "A2": "East", "B2": 100,
        "A3": "West", "B3": 200,
        "A4": "East", "B4": 50,
        "D1": "Region", "D2": "East"
      },
      "expected": 2
    },
    {
      "id": "DCOUNT_all_matching",
      "formula": "=DCOUNT(A1:B4,\"Sales\",D1:D2)",
      "description": "With a criteria that matches every row, counts all numeric Sales entries",
      "setup_cells": {
        "A1": "Region", "B1": "Sales",
        "A2": "East", "B2": 100,
        "A3": "West", "B3": 200,
        "A4": "East", "B4": 50,
        "D1": "Sales", "D2": ">=50"
      },
      "expected": 3
    }
  ]
