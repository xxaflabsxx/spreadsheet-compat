        "D1": "Region", "D2": "West"
      },
      "expected": 200
    },
    {
      "id": "DGET_multiple_matches_error",
      "formula": "=DGET(A1:B4,\"Sales\",D1:D2)",
      "description": "Errors when more than one row matches (East matches two rows), because DGET must return exactly one value. Cross-app difference: Excel and Google Sheets return #NUM! here, but LibreOffice returns #VALUE!.",
      "setup_cells": {
        "A1": "Region", "B1": "Sales",
        "A2": "East", "B2": 100,
        "A3": "West", "B3": 200,
        "A4": "East", "B4": 50,
        "D1": "Region", "D2": "East"
      },
      "expected": "#VALUE!"
    }
  ]
