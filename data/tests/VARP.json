{
  "function": "VARP",
  "cases": [
    {
      "id": "VARP_textbook",
      "formula": "=VARP(2,4,4,4,5,5,7,9)",
      "description": "Population variance (divides by n) of the classic 8-value example; equals STDEVP squared",
      "expected": 4
    },
    {
      "id": "VARP_from_range",
      "formula": "=VARP(A1:A5)",
      "description": "Population variance read from a cell range",
      "setup_cells": {"A1": 2, "A2": 4, "A3": 6, "A4": 8, "A5": 10},
      "expected": 8
    },
    {
      "id": "VARP_two_values",
      "formula": "=VARP(10,20)",
      "description": "Population variance of two values divides the summed squared deviations by n",
      "expected": 25
    },
    {
      "id": "VARP_identical_values",
      "formula": "=VARP(A1:A4)",
      "description": "Identical values have zero variance",
      "setup_cells": {"A1": 7, "A2": 7, "A3": 7, "A4": 7},
      "expected": 0
    }
  ]
}
