{
  "function": "MODE.SNGL",
  "cases": [
    {
      "id": "MODE_SNGL_basic",
      "formula": "=MODE.SNGL(1,2,2,3,4)",
      "description": "Returns the single most frequently occurring value",
      "expected": 2
    },
    {
      "id": "MODE_SNGL_from_range",
      "formula": "=MODE.SNGL(A1:A5)",
      "description": "Most frequent value read from a cell range",
      "setup_cells": {"A1": 5, "A2": 5, "A3": 3, "A4": 3, "A5": 3},
      "expected": 3
    },
    {
      "id": "MODE_SNGL_first_of_ties",
      "formula": "=MODE.SNGL(1,1,2,2)",
      "description": "When two values tie for most frequent, returns the one that appears first",
      "expected": 1
    },
    {
      "id": "MODE_SNGL_negatives",
      "formula": "=MODE.SNGL(-4,-4,7)",
      "description": "Works with negative numbers",
      "expected": -4
    },
    {
      "id": "MODE_SNGL_no_repeats_error",
      "formula": "=MODE.SNGL(1,2,3)",
      "description": "Errors when no value repeats. Note a cross-app difference: Excel and Google Sheets return #N/A here, but LibreOffice returns #VALUE!",
      "expected": "#VALUE!"
    }
  ]
}
