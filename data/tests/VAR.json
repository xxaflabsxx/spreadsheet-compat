      "expected": 4
    },
    {
      "id": "VAR_from_range",
      "formula": "=VAR(A1:A5)",
      "description": "Sample variance read from a cell range",
      "setup_cells": {"A1": 2, "A2": 4, "A3": 6, "A4": 8, "A5": 10},
      "expected": 10
    },
    {
      "id": "VAR_two_values",
      "formula": "=VAR(10,20)",
      "description": "Two values 5 either side of the mean give a sample variance of 50",
      "expected": 50
    },
    {
      "id": "VAR_ignores_text",
      "formula": "=VAR(A1:A4)",
      "description": "Text and blank cells are ignored rather than counted",
      "setup_cells": {"A1": 2, "A2": 4, "A3": 6, "A4": "x"},
      "expected": 4
    }
  ]
}
