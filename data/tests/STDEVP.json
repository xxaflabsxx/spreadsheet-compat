{
  "function": "STDEVP",
  "cases": [
    {
      "id": "STDEVP_textbook",
      "formula": "=STDEVP(2,4,4,4,5,5,7,9)",
      "description": "Population standard deviation of the classic 8-value example (mean 5, variance 4)",
      "expected": 2
    },
    {
      "id": "STDEVP_two_values",
      "formula": "=STDEVP(2,4)",
      "description": "Two values equidistant from their mean of 3 give a population standard deviation of 1",
      "expected": 1
    },
    {
      "id": "STDEVP_from_range",
      "formula": "=STDEVP(A1:A4)",
      "description": "Identical values have zero spread",
      "setup_cells": {"A1": 10, "A2": 10, "A3": 10, "A4": 10},
      "expected": 0
    },
    {
      "id": "STDEVP_ignores_text",
      "formula": "=STDEVP(A1:A4)",
      "description": "Text and blank cells are ignored, not treated as zero",
      "setup_cells": {"A1": 2, "A2": 4, "A3": "x"},
      "expected": 1
    }
  ]
}
