__pycache__/
*.pyc
.DS_Store

# Generated by harness/run_sheets.py: chunk workbooks for Drive import, the
# .xlsx exported back out of Google Sheets, and the selftest scratch output.
# All are reproducible from data/tests/ via `run_sheets.py build`; only the
# ingested results/google-sheets.json is committed.
harness/sheets_chunks/
harness/sheets_exports/
harness/sheets_selftest/
harness/sheets_chunks_plain/
harness/sheets_exports_plain/
# Corpus-growth batch outdirs (same rule: reproducible from data/tests/ via
# `run_sheets.py build --only ...`; only the ingested results are committed).
harness/sheets_chunks_batch2/

# Same three artifact kinds for the how-to RECIPE corpus, produced by
# `run_sheets.py build-recipes` / the orchestrator's Drive round-trip /
# `selftest-recipes`. Reproducible from data/recipes/ at any time; only the
# ingested results/recipes-verified-sheets.json is committed.
harness/recipe_chunks/
harness/recipe_exports/
harness/recipe_selftest/
# --outdir of an engine-scoped build (e.g. the Sheets-only alternative checks).
harness/recipe_chunks_alt/
